@model IEnumerable<AllergyNutritionPlatform.Models.UserAllergy>

@{
    ViewData["Title"] = "Index";
}

<h1>My Allergies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            
            <th>
                @Html.DisplayNameFor(model => model.Allergy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            
            <td>
                @Html.DisplayFor(modelItem => item.Allergy.Name)
            </td>
            <td>
              
<a asp-action="Details"
   asp-route-userId="@item.UserId"
   asp-route-allergyId="@item.AllergyId"
   class="btn btn-success btn-sm">
    Details
</a>

<a asp-action="Delete"
   asp-route-userId="@item.UserId"
   asp-route-allergyId="@item.AllergyId"
   class="btn btn-danger btn-sm">
    Delete
</a>
            </td>
        </tr>
}
    </tbody>
</table>
