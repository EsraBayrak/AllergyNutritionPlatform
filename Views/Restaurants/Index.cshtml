@model IEnumerable<AllergyNutritionPlatform.Models.Restaurant>

@{
    ViewData["Title"] = "Index";
}

<h1>🍽️ Restaurant Recommendations</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HasGlutenFreeOptions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HasVeganOptions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.City)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
               @(item.HasGlutenFreeOptions ? "✅ Yes" : "❌ No")
            </td>
            <td>
               @(item.HasVeganOptions ? "✅ Yes" : "❌ No")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                <a asp-action="Details"
   asp-route-id="@item.Id"
   class="btn btn-success btn-sm">
    Details
</a>

<a asp-action="Edit"
   asp-route-id="@item.Id"
   class="btn btn-warning btn-sm text-dark">
    Edit
</a>

<a asp-action="Delete"
   asp-route-id="@item.Id"
   class="btn btn-danger btn-sm">
    Delete
</a>
            </td>
        </tr>
}
    </tbody>
</table>
