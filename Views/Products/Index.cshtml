@model IEnumerable<AllergyNutritionPlatform.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Products</h1>
<form asp-action="Index" method="get" class="mb-3">
    <input type="text"
           name="searchString"
           value="@ViewData["CurrentSearch"]"
           placeholder="Search by name, brand or category"
           class="form-control mb-2" />

    <select name="statusFilter" class="form-control mb-2">
        <option value="">All</option>
        <option value="Safe">Safe</option>
        <option value="NotSafe">Not Safe</option>
    </select>

    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" class="btn btn-secondary">Clear</a>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-hover shadow">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Brand)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>Contains Allergens</th>
<th>Personal Status</th>
          
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Brand)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @if (item.ProductAllergies.Any())
{
    @string.Join(", ", item.ProductAllergies.Select(pa => pa.Allergy.Name))
}
else
{
    <span>None</span>
}
            </td>


<td>
    @if (ViewBag.IsLoggedIn == false)
    {
        <span>Login to check</span>
    }
    else
    {
        var userAllergyIds = ViewBag.UserAllergyIds as List<int> ?? new List<int>();
        var productAllergyIds = item.ProductAllergies.Select(pa => pa.AllergyId).ToList();

        bool isNotSafe = productAllergyIds.Any(id => userAllergyIds.Contains(id));

       @if (isNotSafe)
{
    <span class="badge bg-danger">
        ❌ Not Safe
    </span>
}
else
{
    <span class="badge bg-success">
        ✅ Safe
    </span>
}
    }
</td>
            <td>
    <a asp-action="Details"
       asp-route-id="@item.Id"
       class="btn btn-sm btn-success">
       Details
    </a>

    <a asp-action="Edit"
       asp-route-id="@item.Id"
       class="btn btn-sm btn-warning">
       Edit
    </a>

    <a asp-action="Delete"
       asp-route-id="@item.Id"
       class="btn btn-sm btn-danger">
       Delete
    </a>

    <a asp-controller="Favorites"
       asp-action="AddToFavorites"
       asp-route-productId="@item.Id"
       class="btn btn-sm btn-info">
       ⭐ Favorite
    </a>
</td>
        </tr>
}
    </tbody>
</table>
